<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The system approval suite. Separate from RavensPort.Core.Tests on purpose, and the separation is
    the safety mechanism rather than tidiness.

    Everything in Core.Tests runs against an InMemoryVault and a temp directory, so `dotnet test` is
    free of side effects and CI runs it on every push. This project does the opposite: it talks to a
    real 1Password vault with a real service-account token, and it deletes what it finds there. That
    must never be something a routine `dotnet test` can trigger by accident.

    Three things keep it out of the way:

      - It is its own project, and pr.yml names tests/RavensPort.Core.Tests explicitly rather than
        testing the solution, so CI does not pick this up by adding it here.
      - Every test is gated behind RequiresServiceAccountFact, which reports Skipped, not passed,
        when the environment is not set up. A system test that silently passes because it never ran
        is worse than no system test.
      - It refuses to run without an explicit acknowledgement variable as well as the token. See
        SystemTestEnvironment.
  -->
  <PropertyGroup>
    <!-- TargetFramework comes from Directory.Build.props — see the note there on why it is shared. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      CS0649 — "field is never assigned to". FakeMcpServer is linked from Core.Tests, where every
      one of its misbehaviour switches is set by some test; this suite uses only a few of them, so
      the compiler reports the rest against this project. Suppressed here and nowhere else: the
      fields are assigned, just not by these tests, and the repository otherwise builds clean.
    -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Same version as RavensPort.Core.Tests carries, and it has to stay that way. The two suites'
      Cobertura reports are merged into one figure (see coverlet.runsettings and coverage.ps1);
      coverlet's instrumentation and its line attribution have changed between majors before, so two
      halves collected by two different collectors would merge into a number that is neither.

      RavensPort.Core.Tests carries the note on why that shared version is 10.x rather than the 6.x
      this started on — in short, 6.x silently reports nothing at all for a module holding
      LibraryImport stubs.
    -->
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RavensPort.Core\RavensPort.Core.csproj" />
  </ItemGroup>

  <!--
    The 1Password SDK native, beside the test assembly so DllImport can find it. RavensPort.App
    carries the same item for the same reason; Core does not, because nothing in Core.Tests reaches
    the native client — they all run against fakes or an InMemoryVault. This suite is the only one
    that opens a real vault, so it is the only test project that needs it.

    Conditioned on the file existing. It is built by Go, not restored by NuGet, and is gitignored,
    so a clean checkout has no copy until someone runs the build. Without the condition every
    `dotnet build` on a fresh clone would fail on a missing item; with it, the suite instead fails
    at the first vault call with a message naming the DLL.
  -->
  <ItemGroup>
    <Content Include="..\..\src\OnePasswordNative\onepassword.dll"
             Condition="Exists('..\..\src\OnePasswordNative\onepassword.dll')">
      <Link>onepassword.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!--
    Linked rather than copied. FakeMcpServer is a few hundred lines of hand-written MCP server whose
    whole value is that it is not the SDK — if both ends of a funnel test were the same library, a
    shared misreading of the protocol would pass unnoticed. That argument holds here too, and having
    two copies drift apart would quietly destroy it.
  -->
  <ItemGroup>
    <Compile Include="..\RavensPort.Core.Tests\Mcp\FakeMcpServer.cs" Link="FakeMcpServer.cs" />
  </ItemGroup>

  <!--
    mTLS is not in the Microsoft Store build, and this suite enables it. Nothing to assert without
    it, and MtlsCertificateFactory.GenerateClientCertificatePfx is not compiled there at all.

    All four files, not just the two that name the missing API. The stages, the host they drive,
    the fixture they share and the attribute that orders them are one unit: removing the first two
    on their own left ApprovalRun holding a SystemTestHost that no longer existed, so
    `dotnet build -p:StoreBuild=true` failed on the fixture rather than skipping the suite.

    SystemTestEnvironment stays. It reads the token and the acknowledgement variable and depends on
    none of the above, so it still compiles — and leaving it means the one file that decides
    whether this suite may touch a real vault is compiled in both configurations rather than only
    in the one that runs it.
  -->
  <ItemGroup Condition="'$(StoreBuild)' == 'true'">
    <Compile Remove="SystemApprovalTests.cs" />
    <Compile Remove="SystemTestHost.cs" />
    <Compile Remove="ApprovalRun.cs" />
    <Compile Remove="StageOrderer.cs" />
  </ItemGroup>

</Project>
