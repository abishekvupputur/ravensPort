<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework comes from Directory.Build.props — see the note there on why it is shared. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      For the LibraryImport stub behind LegacyStorePurgeTests.CreateHardLinkW; see the same
      property in RavensPort.Core.csproj.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- In-memory host used by LocalAccessGuardTests to exercise the middleware end to end. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.5" />
    <!--
      10.x, and the version is load-bearing. RavensPort.Core now carries LibraryImport-generated
      P/Invoke stubs, and coverlet 6.x cannot instrument a module that contains them: it emits no
      warning, writes a well-formed Cobertura report with zero assemblies in it, and every consumer
      downstream reports 0% as though the tests had covered nothing. Measured on this repository at
      6.0.0 and 6.0.4 (238-byte report, "No assemblies have been covered") against 10.0.1 (a full
      one). See the guard in coverage.yml that now fails the build on an empty report.
    -->
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RavensPort.Core\RavensPort.Core.csproj" />
  </ItemGroup>

  <!--
    The mTLS suites cover a feature the Microsoft Store build does not have: with StoreBuild=true,
    MtlsCertificateFactory.GenerateClientCertificatePfx is not compiled at all, so these do not
    build and there would be nothing for them to assert if they did. See BuildProfile.

    CI runs `dotnet test` with no StoreBuild, so the shipped EXE's mTLS is covered exactly as
    before — this only keeps a solution-wide `-p:StoreBuild=true` compiling, which is how the
    store variant is checked locally.
  -->
  <ItemGroup Condition="'$(StoreBuild)' == 'true'">
    <Compile Remove="MtlsCertificatePasswordTests.cs" />
    <Compile Remove="Mcp\McpFunnelMtlsTests.cs" />
    <Compile Remove="Mcp\McpMtlsRedirectTests.cs" />
  </ItemGroup>

</Project>
