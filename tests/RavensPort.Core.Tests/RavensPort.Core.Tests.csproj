<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both frameworks, matching Core — the portable run is what proves a Linux build is honest
         rather than merely compiling. See the note in Directory.Build.props. -->
    <TargetFrameworks>$(PortableTargetFramework);$(WindowsTargetFramework)</TargetFrameworks>
  </PropertyGroup>

  <!--
    The Hello tests, which cover types that only exist on the Windows target — the WinRT signer, the
    Credential Manager store, and the protector that binds them. Everything else in this suite is
    portable and runs on both, which is the point: a Linux build that passes 700-odd tests has been
    checked, not merely compiled.
  -->
  <ItemGroup Condition="!$(TargetFramework.StartsWith('net8.0-windows'))">
    <Compile Remove="Vault\HelloCredentialBindingTests.cs" />
    <Compile Remove="Vault\HelloKeyStorageTests.cs" />
    <Compile Remove="Vault\HelloSealedKeyTests.cs" />
    <Compile Remove="Vault\HelloFakes.cs" />
    <!-- Keeping the 1Password service-account token is Hello-backed too, so its storage tests are
         written against the same protector and fakes. What the portable build does instead — keep
         nothing, and refuse rather than pretend — is UnavailableServiceTokenProtector. -->
    <Compile Remove="Vault\OnePasswordTokenStorageTests.cs" />
    <Compile Remove="Vault\ProtonPassSignInTests.cs" />
    <!-- Reads Authenticode signatures, which is the one thing ExecutableTrust cannot do off
         Windows. What it does instead — refuse — is covered by ExecutableTrustPortableTests. -->
    <Compile Remove="Vault\ExecutableTrustTests.cs" />
  </ItemGroup>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- In-memory host used by LocalAccessGuardTests to exercise the middleware end to end. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.11" />
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Moq" Version="4.20.72" />
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RavensPort.Core\RavensPort.Core.csproj" />
  </ItemGroup>

</Project>
