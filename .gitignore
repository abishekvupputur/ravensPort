# Build output
bin/
obj/
publish/
dist/
[Tt]est[Rr]esults/

# Compiled binaries — never tracked, they belong on the release page
*.exe

# Visual Studio / Rider
.vs/
.idea/
*.user
*.suo
*.userprefs
*.userosscache
*.sln.docstates
*.csproj.user
*.VC.db
*.iml

# Build artefacts
*.pdb
*.cache
*.nupkg
*.snk

# NuGet
packages/
.nuget/

# Logs — the app writes to %AppData%\RavensPort\logs, but keep stray local ones out too
*.log

# Local secrets / state.
# Configuration now lives in the user's password manager, not on disk, so there is no store file
# to leak. Kept anyway: it still catches a pre-2.0 store.dat copied in for reference, and any
# other stray blob someone drops here.
*.dat
local.settings.json

# OS
.DS_Store
Thumbs.db

# Editors / tooling
.vscode/
.claude/

# Go generated files
onepassword.dll
onepassword.h

# SonarScanner working directory, written by `dotnet sonarscanner begin` during a local
# analysis run. Build state, not source.
.sonarqube/
