<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The view models, and the interfaces through which they reach the desktop. No UI framework: no
    UseWPF, no UseWindowsForms, no reference to either. That absence is the point of the project
    rather than an accident of what it happens to need — a WPF type that creeps back into a view
    model fails the build here instead of being noticed during the Avalonia port.

    Portable only. Nothing here is Windows-specific, and it used to be a net8.0-windows assembly
    solely because Core was one and a plain net8.0 project cannot reference a net8.0-windows one.
    Core multi-targets now, so this can be what it always was.

    That is worth more than tidiness: this project is where a Windows dependency would do the most
    damage, and a net8.0 target means one cannot be added by accident.
  -->
  <PropertyGroup>
    <TargetFramework>$(PortableTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RavensPort.Core\RavensPort.Core.csproj" />
  </ItemGroup>

</Project>
