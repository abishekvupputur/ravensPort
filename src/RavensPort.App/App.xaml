<Application x:Class="RavensPort.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RavensPort.App"
             xmlns:helpers="clr-namespace:RavensPort.App.Helpers"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Theme/DarkTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
            <helpers:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <helpers:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
            <helpers:CredentialStatusBrushConverter x:Key="CredentialStatusBrushConverter"/>

            <sys:String x:Key="ProxyKeyHelpText">The secret a caller must present to use this endpoint, and nothing else.

Send it as the "X-Proxy-Key" header, or as "?proxy_key=..." for clients that cannot set headers.

Each route and each funnel has its own key. A key issued for one endpoint does not open any other, so a client that leaks it exposes only what that endpoint reaches — and revoking it costs nothing anywhere else.</sys:String>

            <sys:String x:Key="ProxyKeyExpiryHelpText">How long this key stays valid, measured from when it was last generated.

"Never expires" is right for a config file nobody rotates. A fixed period suits a key handed to something temporary — once it lapses the endpoint answers 403 until you regenerate the key or set a longer period.</sys:String>

            <!-- The key controls, identical for a route and for a funnel, so they live here once
                 rather than as two copies that drift. DataContext is a ProxyKeyViewModel. -->
            <DataTemplate x:Key="ProxyKeyEditorTemplate">
                <StackPanel>
                    <TextBlock Text="Proxy key" Style="{StaticResource FieldLabelStyle}"
                               ToolTip="{StaticResource ProxyKeyHelpText}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <!-- Read-only TextBox rather than a TextBlock so the key can be selected
                             and pasted without going through the clipboard button. -->
                        <TextBox Width="270" IsReadOnly="True" VerticalAlignment="Center"
                                 FontFamily="Cascadia Code, Consolas" FontSize="11"
                                 Text="{Binding Display, Mode=OneWay}"
                                 ToolTip="{StaticResource ProxyKeyHelpText}"/>
                        <Button Content="{Binding ToggleLabel}" Width="60" Margin="6,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ToggleVisibilityCommand}"/>
                        <Button Content="Copy" Width="60" Margin="6,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding CopyCommand}"/>
                        <Button Content="Regenerate" Width="95" Margin="6,0,0,0"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding RegenerateCommand}"
                                ToolTip="Issue a new key for this endpoint. Any client still using the old one gets 403 immediately."/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Valid for" Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center" Margin="0,0,8,0"
                                   ToolTip="{StaticResource ProxyKeyExpiryHelpText}"/>
                        <ComboBox Width="140" VerticalAlignment="Center"
                                  ItemsSource="{Binding Lifetimes}"
                                  SelectedItem="{Binding SelectedLifetime, Mode=TwoWay}"
                                  ToolTip="{StaticResource ProxyKeyExpiryHelpText}"/>
                        <TextBlock Text="{Binding ExpirySummary}" VerticalAlignment="Center" Margin="10,0,0,0"
                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>

                    <TextBlock Text="⚠ this key has expired — the endpoint answers 403 until it is regenerated"
                               FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"
                               Foreground="{StaticResource ErrorBrush}"
                               Visibility="{Binding IsExpired, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
