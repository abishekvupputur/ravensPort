<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net10.0-windows\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <!--
      Compresses the embedded assemblies: ~243 MB down to ~99 MB. This is for the exe published
      as a release asset and downloaded directly, where the size is what a person waits for. It
      costs a slower first start, since the payload is extracted to temp before the app runs.

      The release workflow deliberately overrides this to false for a second publish, whose only
      consumer is the installer. LZMA2 has much more to work with when its input has not already
      been deflated: the raw payload compresses to a 67.9 MB installer, against 94 MB for this
      one. That matters because the Microsoft Store submission is served from a blob committed to
      this repository — it needs a redirect-free raw.githubusercontent.com URL — and GitHub
      refuses a file over 100 MB. See installer/RavensPort.iss and docs/STORE-SUBMISSION.md.
    -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
</Project>
