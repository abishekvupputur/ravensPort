<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- TargetFramework comes from Directory.Build.props — see the note there on why it is shared. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\tray.ico</ApplicationIcon>
    <AssemblyName>RavensPort</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\tray.ico" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\proton-pass-logo.png" />

    <!-- 1Password's own mark, shown on the consent window that asks before keeping a service-account
         token. AgileBits' trademark, used to identify the manager being connected to and nothing
         else. See THIRD-PARTY-NOTICES.md. -->
    <Resource Include="Assets\onepassword-logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\OnePasswordNative\onepassword.dll">
      <Link>onepassword.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      CommunityToolkit.Mvvm is deliberately not referenced here. It belongs to the view models, and
      they live in RavensPort.UI now — leaving it on this project would let a [RelayCommand] be
      written in the view layer, which is exactly the drift the split exists to stop.
    -->
    <ProjectReference Include="..\RavensPort.Core\RavensPort.Core.csproj" />
    <ProjectReference Include="..\RavensPort.UI\RavensPort.UI.csproj" />
  </ItemGroup>

</Project>
