<Window x:Class="RavensPort.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RavensPort.App.Views"
        mc:Ignorable="d"
        Title="RavensPort" Height="688" Width="892" MinHeight="420" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI">
    <!--
        Two whole-window states rather than a banner over a disabled UI: without a reachable
        password manager there is no configuration at all, so the tabs would be four empty grids
        whose every control fails. A Grid with visibility rather than a ContentControl with a
        state DataTemplate, because the code-behind wires the tab views up by x:Name and a
        template would rebuild them out from under it.
    -->
    <Grid>
        <views:SetupView x:Name="SetupViewControl"
                         Visibility="{Binding IsGated, Converter={StaticResource BoolToVisibilityConverter}}"/>

        <DockPanel Visibility="{Binding IsNormal, Converter={StaticResource BoolToVisibilityConverter}}">
            <!--
                Above the tabs rather than inside one: a locked vault stops every tab working, so a
                message tucked into Settings would be found only by someone already looking for it.
            -->
            <Border x:Name="VaultBanner" DockPanel.Dock="Top" Background="{StaticResource AccentSelectedBgBrush}"
                    BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,1" Padding="12,8"
                    DataContext="{Binding VaultStatus}"
                    Visibility="{Binding IsDegraded, Converter={StaticResource BoolToVisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}"/>
                    <TextBlock Text="{Binding Detail}" Style="{StaticResource HintTextStyle}"
                               TextWrapping="Wrap" Margin="0,2,0,0"/>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="I've unlocked it — save now" Margin="0,0,8,0"
                                Command="{Binding SyncNowCommand}"/>
                        <Button Content="Discard and reload from vault" Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding ReloadFromVaultCommand}"/>
                    </StackPanel>

                    <Expander Header="How do I stop this happening?" Margin="0,8,0,0"
                              Foreground="{StaticResource MutedTextBrush}"
                              Visibility="{Binding IsWaitingForUnlock, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="{Binding Guidance}" Style="{StaticResource HintTextStyle}"
                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                    </Expander>
                </StackPanel>
            </Border>

            <!--
                Separate from the unsaved-changes banner above: this one reports what a load
                changed by itself — a credential dropped because its item was deleted in the
                password manager — which the user has to be told even though nothing is pending.
            -->
            <Border DockPanel.Dock="Top" Background="#2A2A3A"
                    BorderBrush="{StaticResource BorderBrush0}" BorderThickness="0,0,0,1" Padding="12,8"
                    DataContext="{Binding VaultStatus}"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVisibilityConverter}}">
                <DockPanel>
                    <Button Content="Dismiss" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0"
                            Style="{StaticResource GhostButtonStyle}" Command="{Binding DismissNoticeCommand}"/>
                    <TextBlock Text="{Binding Notice}" TextWrapping="Wrap"
                               Foreground="{StaticResource TextBrush}"/>
                </DockPanel>
            </Border>

            <TabControl x:Name="TabsControl" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Credentials">
                <views:CredentialsView x:Name="CredentialsViewControl"/>
            </TabItem>
            <TabItem Header="Routes">
                <views:RoutesView x:Name="RoutesViewControl"/>
            </TabItem>
            <TabItem Header="MCP Funnel">
                <views:McpFunnelView x:Name="McpFunnelViewControl"/>
            </TabItem>
            <TabItem Header="API to MCP">
                <views:ApiBridgeView x:Name="ApiBridgeViewControl"/>
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView x:Name="SettingsViewControl"/>
            </TabItem>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>
