<UserControl x:Class="RavensPort.App.Views.McpFunnelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:RavensPort.App.Helpers"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" d:DesignWidth="720"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <sys:String x:Key="FunnelHelpText">A funnel is one local MCP endpoint that pools several MCP servers and exposes only the tools you pick.

Point one AI agent at each funnel. The agent sees a single server offering exactly the tools you allowed, drawn from as many upstreams as you like.</sys:String>

        <sys:String x:Key="SourceKindHelpText">Where this MCP server lives.

Route (credentialed) — an MCP server reached through one of your routes on the Routes tab. The route's OAuth token is attached automatically, so authenticated servers work with no extra setup.
URL (no auth)        — any MCP server that needs no credential.</sys:String>

        <sys:String x:Key="AliasHelpText">Prefixes every name this source contributes, so two servers offering a "search" tool stay distinguishable.

A tool called "create_issue" from a source aliased "gh" reaches the agent as "gh__create_issue".

Prefixing is always on: a name that changed whenever an unrelated source was added would break agent prompts that referred to it.</sys:String>

        <sys:String x:Key="TransportHelpText">How to speak to this server.

Auto            — probe for streamable HTTP, fall back to legacy SSE. Right for almost everything.
Streamable HTTP — the current transport.
SSE             — the older transport, for servers that only implement it.</sys:String>

        <sys:String x:Key="SelectionModeHelpText">How the ticks below are read.

All     — everything this source offers, including anything it gains later.
Include — only what is ticked. A tool the server adds later stays hidden until you pick it.
Exclude — everything except what is ticked. A tool the server adds later is exposed immediately.

Use Include to grant a known set, Exclude to revoke a few from an otherwise trusted server.</sys:String>

        <!-- One selection list. Used three times per source — tools, resources, prompts — which
             are identical in shape, so they share a template rather than three near-copies. -->
        <DataTemplate x:Key="SelectionGroupTemplate">
            <StackPanel Margin="0,0,0,6">
                <Grid Margin="0,0,0,2">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- A plain Button rather than an Expander: Expander's default template
                             is not covered by the dark theme and renders dark-on-dark. -->
                        <Button Content="{Binding ExpandGlyph}" Command="{Binding ToggleExpandedCommand}"
                                Style="{StaticResource GhostButtonStyle}" Width="26" Padding="0"
                                ToolTip="Show or hide this list"/>
                        <TextBlock Text="{Binding Title}" Style="{StaticResource FieldLabelStyle}"
                                   VerticalAlignment="Center" Margin="6,0,0,0"/>
                        <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Margin="8,0,0,0"
                                   FontSize="10" Foreground="{StaticResource MutedTextBrush}"/>
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding AllModes}" SelectedItem="{Binding Mode, Mode=TwoWay}"
                              HorizontalAlignment="Right" Width="110"
                              ToolTip="{StaticResource SelectionModeHelpText}"/>
                </Grid>

                <TextBlock Text="{Binding EmptyHint}" Style="{StaticResource HintTextStyle}" Margin="32,0,0,0"
                           Visibility="{Binding ShowEmptyHint, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <!-- Hidden under "All", where the ticks mean nothing and showing them would
                     invite someone to set a selection that is silently ignored. -->
                <ItemsControl ItemsSource="{Binding Items}" Margin="32,2,0,0"
                              Visibility="{Binding ShowItems, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox Content="{Binding Name}"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Margin="0,1"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Style="{StaticResource HintTextStyle}" Margin="32,2,0,0"
                           Text="Everything this source offers, now and later."
                           Visibility="{Binding ShowAllHint, Converter={StaticResource BoolToVisibilityConverter}}"/>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      helpers:SmoothScroll.Enable="True" Padding="0,0,4,0">
            <StackPanel Margin="16">

                <Grid Margin="0,0,0,6">
                    <TextBlock Text="MCP Funnel" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                    <Button Content="Refresh" HorizontalAlignment="Right" Width="90"
                            Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshCommand}"
                            ToolTip="Re-read sources, funnels, and routes from storage"/>
                </Grid>

                <CheckBox Content="Enable MCP funnel" IsChecked="{Binding IsEnabled}"
                          ToolTip="{StaticResource FunnelHelpText}" Margin="0,0,0,4"/>
                <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,16"
                           Text="Off by default. A funnel lets one caller reach several upstreams — and their OAuth grants — through a single path, so it stays dark until you ask for it."/>

                <!-- Funnels first: the endpoints are the point, sources are the ingredients. -->
                <TextBlock Text="Funnels" Style="{StaticResource SectionHeaderStyle}"/>
                <TextBlock Style="{StaticResource EmptyStateStyle}"
                           Text="No funnels yet — add a source below, then create a funnel and pick what it exposes."
                           Visibility="{Binding HasNoFunnels, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <StackPanel Visibility="{Binding HasFunnels, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource HintTextStyle}"
                               Text="Select a funnel to choose which sources it pools and which of their tools it exposes. Click it again to collapse."/>
                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,6"
                               Text="Each funnel has its own proxy key — only that key opens it, and no route's key does. Send it as the X-Proxy-Key header; that header is the only place the key is read from, and a ?proxy_key= query parameter is ignored and stripped. Without it the endpoint answers 403."/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Funnels}" SelectedItem="{Binding SelectedFunnel}"
                          AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,18"
                          helpers:RowSelectionToggle.Enable="True"
                          Visibility="{Binding HasFunnels, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="LOCAL ENDPOINT" Width="*" MinWidth="260">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <!-- Read-only TextBox rather than a TextBlock so it can be
                                             selected and pasted into an agent's config. -->
                                        <TextBox Text="{Binding LocalUrl, Mode=OneWay}" IsReadOnly="True"
                                                 FontFamily="Cascadia Code, Consolas" FontSize="11"
                                                 Background="Transparent" BorderThickness="0" Padding="0"
                                                 Foreground="{StaticResource AccentBrush}"/>
                                        <TextBlock Text="{Binding Name}" FontSize="10"
                                                   Foreground="{StaticResource DisabledTextBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="POOLS" Binding="{Binding SourceSummary}" Width="110"/>

                        <!-- Status only; the key itself is in the editor below, where it can be
                             shown, copied, and re-issued. -->
                        <DataGridTemplateColumn Header="PROXY KEY" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" ToolTip="{StaticResource ProxyKeyHelpText}">
                                        <TextBlock Text="{Binding Key.ExpirySummary}" TextWrapping="Wrap" FontSize="10">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Key.IsExpired}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="⚠ expired — this funnel answers 403" FontSize="10" TextWrapping="Wrap"
                                                   Foreground="{StaticResource ErrorBrush}"
                                                   Visibility="{Binding Key.IsExpired, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="ENABLED" ToolTip="Uncheck to stop serving this endpoint without deleting it."/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Delete" Margin="2" Style="{StaticResource GhostButtonStyle}"
                                            Command="{Binding DataContext.DeleteFunnelCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- What the selected funnel exposes. -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14"
                        Visibility="{Binding HasSelectedFunnel, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedFunnelTitle}" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,10"
                                   Text="Changes apply to the agent's next call — no reconnect needed."/>

                        <!-- This funnel's own key. Nothing else opens the endpoint, so it belongs
                             next to the endpoint rather than in a global setting. -->
                        <ContentControl Content="{Binding SelectedFunnel.Key}"
                                        ContentTemplate="{StaticResource ProxyKeyEditorTemplate}"/>

                        <TextBlock Text="Endpoint URL with the key attached" Style="{StaticResource FieldLabelStyle}"
                                   Margin="0,10,0,0"
                                   ToolTip="Most MCP clients are configured from a JSON file and cannot set a header. Paste this form instead."/>
                        <TextBox Text="{Binding SelectedFunnel.LocalUrlWithKey, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Cascadia Code, Consolas" FontSize="11"
                                 Background="Transparent" BorderThickness="0" Padding="0"
                                 Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,10"
                                   Text="Press Show above to reveal the key inside this URL before copying it."/>

                        <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                                Margin="0,0,0,10"/>

                        <ItemsControl ItemsSource="{Binding FunnelSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource PanelAltBrush}"
                                            BorderBrush="{StaticResource BorderSubtleBrush}"
                                            BorderThickness="1" CornerRadius="3" Padding="10" Margin="0,0,0,6">
                                        <StackPanel>
                                            <Grid>
                                                <CheckBox IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center" Margin="0,0,40,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding Name}"/>
                                                        <TextBlock Text="{Binding ToolPrefix, StringFormat='tools appear as {0}…'}"
                                                                   FontSize="10" FontFamily="Cascadia Code, Consolas"
                                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                                        <!-- What the row is doing, so it can stay
                                                             collapsed and still be readable. -->
                                                        <TextBlock Text="{Binding Summary}" FontSize="10" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource DisabledTextBrush}"/>
                                                    </StackPanel>
                                                </CheckBox>

                                                <Button Content="{Binding ExpandGlyph}" Command="{Binding ToggleExpandedCommand}"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Width="30" Padding="0"
                                                        ToolTip="Show or hide what this source exposes"
                                                        Visibility="{Binding IsIncluded, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                            </Grid>

                                            <StackPanel Margin="22,10,0,0"
                                                        Visibility="{Binding ShowDetail, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <ContentControl Content="{Binding Tools}" ContentTemplate="{StaticResource SelectionGroupTemplate}"/>
                                                <ContentControl Content="{Binding Resources}" ContentTemplate="{StaticResource SelectionGroupTemplate}"/>
                                                <ContentControl Content="{Binding Prompts}" ContentTemplate="{StaticResource SelectionGroupTemplate}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Add funnel" Style="{StaticResource SectionHeaderStyle}"/>
                        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding NewFunnelName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Endpoint slug (optional)" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding NewFunnelSlug, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="Last part of the URL, e.g. /mcp/coding-agent. Derived from the name if left blank."/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="0,0,0,8" HorizontalAlignment="Left">
                            <TextBlock Text="Proxy key validity" Style="{StaticResource FieldLabelStyle}"
                                       ToolTip="{StaticResource ProxyKeyExpiryHelpText}"/>
                            <ComboBox Width="180" HorizontalAlignment="Left"
                                      ItemsSource="{Binding KeyLifetimes}"
                                      SelectedItem="{Binding NewFunnelKeyLifetime, Mode=TwoWay}"
                                      ToolTip="{StaticResource ProxyKeyExpiryHelpText}"/>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="The funnel gets its own key on creation — copy it from the panel above after selecting the funnel. Changeable at any time."/>
                        </StackPanel>
                        <Button Content="Add funnel" HorizontalAlignment="Left" Width="110" Command="{Binding AddFunnelCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Sources. -->
                <Grid Margin="0,4,0,6">
                    <TextBlock Text="Sources" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                    <!-- The footer carries which source is being contacted, but the footer is at the
                         bottom of a long page and this button is in the middle of it. Saying so on
                         the button itself is what tells someone who just clicked that it took. -->
                    <Button HorizontalAlignment="Right" Width="100"
                            Command="{Binding RefreshAllSourcesCommand}"
                            ToolTip="Connect to every enabled source and re-read the tools it offers">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                                <Setter Property="Content" Value="Refresh all"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding RefreshAllSourcesCommand.IsRunning}" Value="True">
                                        <Setter Property="Content" Value="Checking…"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>

                <TextBlock Style="{StaticResource EmptyStateStyle}"
                           Text="No sources yet — add an MCP server below."
                           Visibility="{Binding HasNoSources, Converter={StaticResource BoolToVisibilityConverter}}"/>

                <DataGrid ItemsSource="{Binding Sources}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,14"
                          Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="SOURCE" Width="*" MinWidth="200">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Target}" FontSize="10" TextWrapping="Wrap"
                                                   FontFamily="Cascadia Code, Consolas"
                                                   Foreground="{StaticResource MutedTextBrush}"/>
                                        <TextBlock Text="⚠ route missing — this source cannot be reached" FontSize="10"
                                                   Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                                   Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="PREFIX" Binding="{Binding Alias}" Width="90"/>
                        <DataGridTextColumn Header="KIND" Binding="{Binding KindLabel}" Width="140"/>

                        <DataGridTemplateColumn Header="STATUS" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!-- Trimmed rather than wrapped, and capped upstream by
                                         McpSourceCatalog.Summarize: a failure message can carry
                                         the upstream's whole response body, and a wrapping cell
                                         grew to the height of that page. The full text is on the
                                         tooltip. -->
                                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding StatusDetail}" VerticalAlignment="Center" FontSize="11"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.Header>
                                <TextBlock Text="ENABLED" ToolTip="Uncheck to stop pooling this source in every funnel at once."/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="Refresh" Margin="2" Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding DataContext.RefreshSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Connect and re-read the tools, resources, and prompts this server offers"/>
                                        <Button Content="Delete" Margin="2" Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding DataContext.DeleteSourceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Add source" Style="{StaticResource SectionHeaderStyle}"/>
                        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding NewSourceName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Tool prefix (optional)" Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="{StaticResource AliasHelpText}"/>
                                <TextBox Text="{Binding NewSourceAlias, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{StaticResource AliasHelpText}"/>
                            </StackPanel>
                        </UniformGrid>

                        <UniformGrid Columns="2" Rows="1" Margin="0,0,0,8">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Kind" Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="{StaticResource SourceKindHelpText}"/>
                                <ComboBox ItemsSource="{Binding AllKinds}" SelectedItem="{Binding NewSourceKind, Mode=TwoWay}"
                                          ToolTip="{StaticResource SourceKindHelpText}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Transport" Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="{StaticResource TransportHelpText}"/>
                                <ComboBox ItemsSource="{Binding AllTransports}" SelectedItem="{Binding NewSourceTransport, Mode=TwoWay}"
                                          ToolTip="{StaticResource TransportHelpText}"/>
                            </StackPanel>
                        </UniformGrid>

                        <StackPanel Margin="0,0,0,8"
                                    Visibility="{Binding IsRouteSource, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Route" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Routes}" SelectedItem="{Binding NewSourceRoute}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding PathPrefix}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="The route's OAuth token is attached automatically — that is the point of pooling an authenticated server here."/>
                        </StackPanel>

                        <StackPanel Margin="0,0,0,8"
                                    Visibility="{Binding IsUrlSource, Converter={StaticResource BoolToVisibilityConverter}}">
                            <TextBlock Text="Server URL" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding NewSourceUrl, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Style="{StaticResource HintTextStyle}"
                                       Text="For servers needing no credential. https required, except on localhost."/>
                        </StackPanel>

                        <Button Content="Add source" HorizontalAlignment="Left" Width="110" Command="{Binding AddSourceCommand}"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Pinned footer: status stays visible instead of scrolling out of view. -->
        <Border Grid.Row="1" Style="{StaticResource FooterBarStyle}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FooterTextStyle}"/>
        </Border>
    </Grid>
</UserControl>
