<Window x:Class="RavensPort.App.Views.OpenApiOperationPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RavensPort.App.ViewModels"
        mc:Ignorable="d"
        Title="Select operations to import" Height="640" Width="900" MinHeight="380" MinWidth="620"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}"
        TextElement.FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Style="{StaticResource HintTextStyle}" Margin="0,0,0,12"
                   Text="Tick the operations you want as tools. Search accepts * and ? wildcards and covers the method, path, operation ID, summary and tags — a plain word matches anywhere, a pattern with a wildcard must match the whole field."/>

        <!-- Search -->
        <TextBox Grid.Row="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                 VerticalContentAlignment="Center"
                 ToolTip="Try: user &#x2022; /repos/* &#x2022; GET &#x2022; *pulls* &#x2022; issues_?et*"/>

        <!-- Grouping, and the two that act on everything the search is showing. -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" Text="Group by" Style="{StaticResource FieldLabelStyle}"
                       VerticalAlignment="Center" Margin="0,0,8,0"/>

            <!-- An ItemTemplate rather than DisplayMemberPath: the themed ComboBox draws its
                 selection box from SelectionBoxItemTemplate, which mirrors ItemTemplate only.
                 DisplayMemberPath works through an internal template selector that never reaches
                 it, so the closed box fell back to ToString() and read "OpenApiGroupingOption…". -->
            <ComboBox Grid.Column="1" Width="150" ItemsSource="{Binding GroupingOptions}"
                      SelectedItem="{Binding Grouping}"
                      ToolTip="Buckets the list so a thousand-operation document is not one flat wall of rows">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <TextBlock Grid.Column="2" Text="{Binding MatchSummary}" Style="{StaticResource HintTextStyle}"
                       VerticalAlignment="Center" Margin="12,0,12,0" TextTrimming="CharacterEllipsis"/>

            <Button Grid.Column="3" Content="Select all" Margin="2,0" Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding SelectAllCommand}" ToolTip="Tick every operation the search is showing"/>
            <Button Grid.Column="4" Content="Select none" Margin="2,0" Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding SelectNoneCommand}" ToolTip="Untick every operation the search is showing"/>
        </Grid>

        <!-- The two caps, always on screen rather than reported afterwards. A manifest is limited
             on both count and stored size, and either one alone can trim the import, so both are
             shown against their limit and both go red on their own. -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,10">
            <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource HintTextStyle}"
                       VerticalAlignment="Center" Margin="0,0,14,0"/>

            <Border Style="{StaticResource CapChipStyle}"
                    ToolTip="A manifest may declare at most 64 tools. Anything over that is dropped from the end of the list.">
                <TextBlock Text="{Binding ToolCountSummary}" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverToolCap}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <Border Style="{StaticResource CapChipStyle}"
                    ToolTip="The manifest's stored size. Estimated from the operations ticked — the exact figure depends on the final serialization, so treat it as close rather than precise.">
                <TextBlock Text="{Binding SizeSummary}" FontSize="11">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverSizeCap}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>

            <TextBlock Text="over the cap — the extra will be dropped" FontSize="11" VerticalAlignment="Center"
                       Margin="4,0,0,0" Foreground="{StaticResource ErrorBrush}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOverToolCap}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsOverSizeCap}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <TreeView Grid.Row="4" ItemsSource="{Binding Tree}"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                </Style>
            </TreeView.ItemContainerStyle>

            <TreeView.Resources>
                <!-- A group: its tick box selects or clears everything beneath it, at whatever
                     level it sits, and shows a dash while only some of it is ticked. -->
                <HierarchicalDataTemplate DataType="{x:Type vm:OpenApiOperationGroupViewModel}"
                                          ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsThreeState="False"
                                  VerticalAlignment="Center"
                                  ToolTip="Select or clear everything in this group"/>
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CountLabel}" Margin="8,0,0,0" FontSize="11"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource DisabledTextBrush}"/>
                    </StackPanel>
                </HierarchicalDataTemplate>

                <DataTemplate DataType="{x:Type vm:OpenApiOperationRowViewModel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="58"/>
                            <ColumnDefinition Width="Auto" MinWidth="220"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                  VerticalAlignment="Center"/>

                        <TextBlock Grid.Column="1" Text="{Binding Method}" FontSize="10" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>

                        <TextBlock Grid.Column="2" Text="{Binding Path}" FontFamily="Cascadia Code, Consolas"
                                   FontSize="11" VerticalAlignment="Center" Margin="0,0,12,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding OperationId}"/>

                        <TextBlock Grid.Column="3" Text="{Binding Summary}" FontSize="11"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   ToolTip="{Binding Summary}"/>
                    </Grid>
                </DataTemplate>
            </TreeView.Resources>
        </TreeView>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0" Style="{StaticResource GhostButtonStyle}"
                    Command="{Binding CancelCommand}" IsCancel="True"/>
            <Button Content="Import" Width="90" Command="{Binding ImportCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
