<UserControl x:Class="RavensPort.App.Views.RoutesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:RavensPort.App.Helpers"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" d:DesignWidth="720"
             Background="{StaticResource BgBrush}">
    <UserControl.Resources>
        <sys:String x:Key="StripPrefixHelpText">Strip prefix: remove the local path prefix before forwarding.

ON  — /app/foo/bar  is sent upstream as  /bar
OFF — /app/foo/bar  is sent upstream as  /app/foo/bar

Leave this ON unless the upstream genuinely expects the prefix in its path.</sys:String>

        <sys:String x:Key="CredentialPlacementHelpText">Where the access token is put on the forwarded request.

Header — Authorization: Bearer &lt;token&gt;   (the default; what almost every OAuth API expects)
Body   — a field added to the JSON object or form body

Query strings are not offered: they are written to the upstream's access log, to every intermediary's, and to browser history, so a token placed there leaks somewhere RavensPort cannot reach.

Body only works on a JSON or application/x-www-form-urlencoded body under 1 MB that declares a Content-Length; anything else is forwarded untouched and the activity log says so.</sys:String>

        <sys:String x:Key="ValuePrefixHelpText">Text placed immediately before the token.

"Bearer " (with the trailing space) produces  Authorization: Bearer &lt;token&gt;.
Leave empty to send the bare token, e.g. for X-Api-Key or ?access_token=.</sys:String>

        <sys:String x:Key="MultiCredentialHelpText">A route can attach any number of credentials, in any mix of places.

None       — the request is forwarded as-is, with no token attached.
One        — the usual case, e.g. Authorization: Bearer &lt;token&gt;.
Several    — e.g. a header plus two query parameters, or a header plus a body field.

Entries may reuse the same credential in different places, or use different credentials side by side. Two entries may not write the same header, query parameter, or body field — the second would silently overwrite the first.</sys:String>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      helpers:SmoothScroll.Enable="True" Padding="0,0,4,0">
            <StackPanel Margin="16">
            <!-- Saved routes first: what's configured is more useful at a glance than the
                 forms used to create it. -->
            <Grid Margin="0,0,0,6">
                <TextBlock Text="Routes" Style="{StaticResource SectionHeaderStyle}" VerticalAlignment="Center"/>
                <Button Content="Refresh" HorizontalAlignment="Right" Width="90"
                        Style="{StaticResource GhostButtonStyle}" Command="{Binding RefreshCommand}"
                        ToolTip="Re-read credentials, upstreams and routes from storage"/>
            </Grid>

            <TextBlock Style="{StaticResource EmptyStateStyle}"
                       Text="No routes yet — add an upstream below, then map a path prefix to it."
                       Visibility="{Binding HasNoRoutes, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,6"
                       Text="Select a route to copy its proxy key or change how its credential is sent. Click it again to collapse."
                       Visibility="{Binding HasRoutes, Converter={StaticResource BoolToVisibilityConverter}}"/>

            <DataGrid ItemsSource="{Binding Routes}" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,18"
                      RowDetailsVisibilityMode="VisibleWhenSelected"
                      helpers:RowSelectionToggle.Enable="True"
                      Visibility="{Binding HasRoutes, Converter={StaticResource BoolToVisibilityConverter}}">
                <!-- Editing lives in the row details rather than in cells: the grid is
                     IsReadOnly (so nested controls stay clickable), and three labelled fields
                     do not fit a column anyway. -->
                <DataGrid.RowDetailsTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderSubtleBrush}"
                                BorderThickness="0,1,0,0" Padding="12,10">
                            <StackPanel>
                                <!-- The key that opens this route, first: it is what a caller
                                     needs before anything below it matters. -->
                                <ContentControl Content="{Binding Key}" ContentTemplate="{StaticResource ProxyKeyEditorTemplate}"/>

                                <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0"
                                        Margin="0,10,0,10"/>

                                <TextBlock Text="Credentials attached to this route" Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="{StaticResource MultiCredentialHelpText}"/>

                                <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,6"
                                           Text="None — requests are forwarded to the upstream with nothing attached."
                                           Visibility="{Binding HasNoCredentials, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                <!-- One editor per attached credential. Any number, in any mix of
                                     header / query / body slots. -->
                                <ItemsControl ItemsSource="{Binding Credentials}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1"
                                                    Padding="0,0,0,8" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,4">
                                                        <TextBlock Text="{Binding InjectionSummary, StringFormat='Upstream receives: {0}'}"
                                                                   Style="{StaticResource HintTextStyle}" VerticalAlignment="Center"/>
                                                        <Button Content="Remove" HorizontalAlignment="Right" Width="80"
                                                                Style="{StaticResource GhostButtonStyle}"
                                                                Command="{Binding DataContext.RemoveCredentialCommand, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="Stop attaching this credential on this route."/>
                                                    </Grid>
                                                    <UniformGrid Columns="4" Rows="1">
                                                        <StackPanel Margin="0,0,6,0">
                                                            <TextBlock Text="Credential" Style="{StaticResource FieldLabelStyle}"/>
                                                            <ComboBox ItemsSource="{Binding AvailableCredentials}"
                                                                      SelectedItem="{Binding Credential, Mode=TwoWay}">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <TextBlock Text="{Binding Name}"/>
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <TextBlock Text="⚠ credential missing" FontSize="10"
                                                                       Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                                                       Visibility="{Binding IsMissingCredential, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="Placement" Style="{StaticResource FieldLabelStyle}"/>
                                                            <ComboBox ItemsSource="{Binding Placements}"
                                                                      SelectedItem="{Binding Placement, Mode=TwoWay}"
                                                                      ToolTip="{StaticResource CredentialPlacementHelpText}"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0">
                                                            <TextBlock Text="{Binding ParameterNameLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                                            <TextBox Text="{Binding ParameterName, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                                                        </StackPanel>
                                                        <StackPanel Margin="6,0,0,0">
                                                            <TextBlock Text="Value prefix" Style="{StaticResource FieldLabelStyle}"
                                                                       ToolTip="{StaticResource ValuePrefixHelpText}"/>
                                                            <TextBox Text="{Binding ValuePrefix, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                                     ToolTip="{StaticResource ValuePrefixHelpText}"/>
                                                        </StackPanel>
                                                    </UniformGrid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Button Content="Add credential" HorizontalAlignment="Left" Width="120"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding AddCredentialCommand}"
                                        ToolTip="{StaticResource MultiCredentialHelpText}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </DataGrid.RowDetailsTemplate>
                <DataGrid.Columns>
                    <!-- The full local endpoint, ready to paste into an MCP client config. -->
                    <DataGridTemplateColumn Header="LOCAL ENDPOINT" Width="*" MinWidth="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" ToolTip="{Binding Summary}">
                                    <TextBox Text="{Binding LocalUrl, Mode=OneWay}" IsReadOnly="True"
                                             FontFamily="Cascadia Code, Consolas" FontSize="11"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{StaticResource AccentBrush}"/>
                                    <TextBlock Text="{Binding PathPrefix}" FontSize="10"
                                               Foreground="{StaticResource DisabledTextBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Where it actually forwards to: upstream name plus its base URL. -->
                    <DataGridTemplateColumn Header="FORWARDS TO" Width="*" MinWidth="230">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" ToolTip="{Binding Summary}">
                                    <TextBlock Text="{Binding UpstreamName}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding UpstreamBaseUrl}" TextWrapping="Wrap" FontSize="10"
                                               FontFamily="Cascadia Code, Consolas"
                                               Foreground="{StaticResource MutedTextBrush}"/>
                                    <TextBlock Text="⚠ upstream missing — this route is not served" FontSize="10"
                                               Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                               Visibility="{Binding IsBroken, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Status only. The key itself is in the row details, where it can be shown,
                         copied, and re-issued without a cell fighting for width. -->
                    <DataGridTemplateColumn Header="PROXY KEY" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center" ToolTip="{StaticResource ProxyKeyHelpText}">
                                    <TextBlock Text="{Binding Key.ExpirySummary}" TextWrapping="Wrap" FontSize="10">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Key.IsExpired}" Value="True">
                                                        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="⚠ expired — this route answers 403" FontSize="10" TextWrapping="Wrap"
                                               Foreground="{StaticResource ErrorBrush}"
                                               Visibility="{Binding Key.IsExpired, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="TOKENS SENT" Width="220">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- Every attached credential and where it goes, so a route with
                                     two of them (or none) is visible without opening the editor. -->
                                <TextBlock Text="{Binding CredentialSummary}" TextWrapping="Wrap" FontSize="10"
                                           VerticalAlignment="Center" ToolTip="{Binding Summary}"
                                           FontFamily="Cascadia Code, Consolas"
                                           Foreground="{StaticResource MutedTextBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Template columns, not DataGridCheckBoxColumn: the grid is IsReadOnly,
                         which renders built-in checkbox columns inert. These stay clickable
                         and write straight through to the route. -->
                    <DataGridTemplateColumn Width="60">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="ENABLED"
                                       ToolTip="Uncheck to stop serving this route without deleting it."/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="Uncheck to stop serving this route without deleting it."/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="95">
                        <DataGridTemplateColumn.Header>
                            <TextBlock Text="STRIP PREFIX" ToolTip="{StaticResource StripPrefixHelpText}"/>
                        </DataGridTemplateColumn.Header>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding StripPrefix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          ToolTip="{StaticResource StripPrefixHelpText}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Delete" Margin="2" Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding DataContext.DeleteRouteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Upstreams" Style="{StaticResource SectionHeaderStyle}"/>
                    <UniformGrid Columns="2" Rows="1" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Name" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding NewUpstreamName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Base URL" Style="{StaticResource FieldLabelStyle}"/>
                            <TextBox Text="{Binding NewUpstreamBaseUrl, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </UniformGrid>
                    <Button Content="Add upstream" HorizontalAlignment="Left" Width="120" Command="{Binding AddUpstreamCommand}" Margin="0,0,0,10"/>
                    <TextBlock Style="{StaticResource EmptyStateStyle}" Text="No upstreams yet."
                               Visibility="{Binding HasNoUpstreams, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <!-- No MaxHeight: a nested scroll region here is exactly what made the
                         wheel feel stuck. The page scrolls instead. -->
                    <DataGrid ItemsSource="{Binding Upstreams}" AutoGenerateColumns="False" IsReadOnly="True"
                              Visibility="{Binding HasUpstreams, Converter={StaticResource BoolToVisibilityConverter}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="BASE URL" Binding="{Binding BaseUrl}" Width="*" MinWidth="150">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Delete" Margin="2" Style="{StaticResource GhostButtonStyle}"
                                                Command="{Binding DataContext.DeleteUpstreamCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="Add route" Style="{StaticResource SectionHeaderStyle}"/>
                    <TextBlock Text="Path prefix (e.g. /app/gmail-mcp)" Style="{StaticResource FieldLabelStyle}"/>
                    <TextBox Text="{Binding NewRoutePathPrefix, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"/>
                    <UniformGrid Columns="2" Rows="1" Margin="0,0,0,8">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock Text="Upstream" Style="{StaticResource FieldLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Upstreams}" SelectedItem="{Binding NewRouteUpstream}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"/>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <StackPanel Margin="6,0,0,0">
                            <TextBlock Text="Credential (optional)" Style="{StaticResource FieldLabelStyle}"
                                       ToolTip="{StaticResource MultiCredentialHelpText}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Credentials}" SelectedItem="{Binding NewRouteCredential}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <!-- A ComboBox has no way back to "nothing selected", and a route
                                     with no credential is a supported configuration. -->
                                <Button Grid.Column="1" Content="None" Width="55" Margin="4,0,0,0"
                                        Style="{StaticResource GhostButtonStyle}"
                                        Command="{Binding ClearNewRouteCredentialCommand}"
                                        ToolTip="Create the route with no credential — requests are forwarded unauthenticated."/>
                            </Grid>
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Margin="0,0,0,8" HorizontalAlignment="Left">
                        <TextBlock Text="Proxy key validity" Style="{StaticResource FieldLabelStyle}"
                                   ToolTip="{StaticResource ProxyKeyExpiryHelpText}"/>
                        <ComboBox Width="180" HorizontalAlignment="Left"
                                  ItemsSource="{Binding KeyLifetimes}"
                                  SelectedItem="{Binding NewRouteKeyLifetime, Mode=TwoWay}"
                                  ToolTip="{StaticResource ProxyKeyExpiryHelpText}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}"
                                   Text="The route gets its own key on creation — copy it from the route's row afterwards. Changeable at any time."/>
                    </StackPanel>

                    <CheckBox Content="Strip path prefix before forwarding" IsChecked="{Binding NewRouteStripPrefix}"
                              ToolTip="{StaticResource StripPrefixHelpText}" Margin="0,0,0,4"/>
                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,10"
                               Text="Recommended. With this on, /app/foo/bar is forwarded upstream as /bar — the prefix is just your local label."/>

                    <!-- Defaults to Authorization: Bearer <token>, so this whole block can be
                         ignored unless the upstream wants the token somewhere else. Hidden when
                         no credential is picked, since there is then nothing to place. -->
                    <StackPanel Visibility="{Binding NewRouteHasCredential, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="Credential is sent as" Style="{StaticResource FieldLabelStyle}"
                                   ToolTip="{StaticResource CredentialPlacementHelpText}"/>
                        <UniformGrid Columns="3" Rows="1" Margin="0,0,0,6">
                            <StackPanel Margin="0,0,6,0">
                                <TextBlock Text="Placement" Style="{StaticResource FieldLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Placements}"
                                          SelectedItem="{Binding NewRouteCredentialPlacement, Mode=TwoWay}"
                                          ToolTip="{StaticResource CredentialPlacementHelpText}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0">
                                <TextBlock Text="{Binding NewRouteParameterNameLabel}" Style="{StaticResource FieldLabelStyle}"/>
                                <TextBox Text="{Binding NewRouteCredentialParameterName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Margin="6,0,0,0">
                                <TextBlock Text="Value prefix" Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="{StaticResource ValuePrefixHelpText}"/>
                                <TextBox Text="{Binding NewRouteCredentialValuePrefix, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{StaticResource ValuePrefixHelpText}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,4"
                               Text="{Binding NewRouteInjectionSummary, StringFormat='Upstream receives: {0}'}"/>
                    <TextBlock Style="{StaticResource HintTextStyle}" Margin="0,0,0,10"
                               Text="More credentials can be attached after the route exists — select it above and use 'Add credential'."
                               ToolTip="{StaticResource MultiCredentialHelpText}"/>
                    <Button Content="Add route" HorizontalAlignment="Left" Width="100" Command="{Binding AddRouteCommand}"/>
                </StackPanel>
            </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Pinned footer: status stays visible instead of scrolling out of view. -->
        <Border Grid.Row="1" Style="{StaticResource FooterBarStyle}">
            <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FooterTextStyle}"/>
        </Border>
    </Grid>
</UserControl>
