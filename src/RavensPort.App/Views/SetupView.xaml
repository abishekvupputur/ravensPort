<UserControl x:Class="RavensPort.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:RavensPort.App.Helpers"
             mc:Ignorable="d" d:DesignWidth="640"
             Background="{StaticResource BgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      helpers:SmoothScroll.Enable="True" Padding="0,0,4,0">
            <StackPanel Margin="16">

                <TextBlock Text="Set up your password manager" Style="{StaticResource SectionHeaderStyle}"
                           FontSize="18" Margin="0,0,0,6"/>
                <!-- xml:space on the runs that end in a space: XAML trims a run's trailing
                     whitespace otherwise, and the emphasised words run into the words before. -->
                <!-- The manager names are bound, not written: the Microsoft Store build has no
                     Proton Pass (10.1.5), and a sentence still offering it would be the promise the
                     cards below no longer keep. See SetupViewModel.SupportedManagers. -->
                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16"><Run
                    xml:space="preserve">RavensPort keeps everything — credentials, tokens, API keys, proxy keys, routes and MCP funnels — in a vault called 'RavensPort' in </Run><Run
                    Text="{Binding SupportedManagers, Mode=OneTime}"/><Run
                    xml:space="preserve">. </Run><Run
                    Style="{StaticResource EmphasisRunStyle}">Nothing is stored on this PC</Run><Run
                    >, so the proxy does not start until your vault is unlocked.</Run></TextBlock>

                <!-- Says the thing the page's own behaviour now demonstrates. Startup only looks for
                     the binaries; no manager is asked anything, so no manager prompts. -->
                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,16"><Run
                    Style="{StaticResource EmphasisRunStyle}">You will only be asked to unlock when you press Connect.</Run><Run
                    xml:space="preserve"> RavensPort checks which password managers are installed and stops there — it does not read your vaults, or open a session, until you choose one.</Run></TextBlock>

                <!-- Experimental warning requested by user -->
                <Border Background="{StaticResource PanelAltBrush}" BorderBrush="{StaticResource BorderBrush0}"
                        BorderThickness="1" Padding="11,9" CornerRadius="6" Margin="0,0,0,14">
                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Foreground="{StaticResource TextBrush}" FontWeight="Bold"><Run
                        Style="{StaticResource EmphasisRunStyle}">Experimental feature:</Run><Run
                        xml:space="preserve"> Having a second vault per password manager and using two password managers at the same time, although possible, is still experimental and is under testing.</Run></TextBlock>
                </Border>

                <!-- Standalone rather than part of the "which vault" card below. That card only
                     appears when more than one manager has already been opened, and after a
                     disconnect nothing has been opened at all — so the explanation for why the app
                     is suddenly serving nothing had nowhere to appear. -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14"
                        Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Disconnected" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"><Run
                            xml:space="preserve">You disconnected, so </Run><Run
                            Style="{StaticResource EmphasisRunStyle}">RavensPort is holding no configuration and is proxying nothing</Run><Run
                            xml:space="preserve">. Connect a password manager below to load one, or start again in single use. Nothing in your vault was deleted.</Run></TextBlock>
                    </StackPanel>
                </Border>

                <!-- Port conflict: shown instead of the manager cards, since the vault is fine and
                     the only thing wrong is the port. -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14"
                        Visibility="{Binding HasPortConflict, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="That port is already in use" Style="{StaticResource SectionHeaderStyle}"
                                   Foreground="{StaticResource ErrorBrush}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Close whatever else is listening on it, or pick another. The port is stored in your vault, so changing it here writes it there."/>
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="100" Text="{Binding ListenPort, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Content="Use this port" Margin="8,0,0,0"
                                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                                    Command="{Binding RetryPortCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Both managers qualify and neither can be shown to hold the configuration.
                     Asked every launch: the choice is the one thing that cannot live in the vault,
                     and nothing about this app is stored locally. -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14"
                        Visibility="{Binding NeedsAChoice, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Which vault should RavensPort open?" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding IsDisconnected, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                   Text="These are the RavensPort vaults found in your password managers. Each is a separate profile — its own credentials, routes and funnels — and RavensPort opens one at a time, because writing to two would leave them quietly disagreeing. You will be asked again next time you start it."/>
                        <!-- After a disconnect the same buttons mean "connect again", and nothing
                             is loaded until one is pressed. -->
                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisibilityConverter}}"><Run
                            xml:space="preserve">You disconnected from your password manager, so </Run><Run
                            Style="{StaticResource EmphasisRunStyle}">RavensPort is holding no configuration and is proxying nothing</Run><Run
                            >. Choose a vault below to load it and start again.</Run></TextBlock>
                        <ItemsControl ItemsSource="{Binding Managers}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Listed per manager rather than in one pile: the same vault
                                         name can exist in both, and "RavensPort" on its own
                                         does not say which password manager it is in. -->
                                    <StackPanel Margin="0,0,0,10"
                                                Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource HintTextStyle}"
                                                   FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <ItemsControl ItemsSource="{Binding VaultButtons}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Disabled while a vault is being read: that
                                                         takes seconds, and a page whose buttons
                                                         still look pressable reads as one where
                                                         the press did nothing. -->
                                                    <Button Content="{Binding Name}" Margin="0,0,8,6" MinWidth="130"
                                                            IsEnabled="{Binding DataContext.IsBusy,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                                        Converter={StaticResource InverseBoolConverter}}"
                                                            Command="{Binding DataContext.UseNamedVaultCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <!-- Ready, but with nothing named RavensPort to offer —
                                             a vault adopted under another name. Choosing the
                                             manager opens whichever vault it resolved, so this
                                             state is never a dead end. -->
                                        <Button Content="{Binding Name}" ContentStringFormat="Use {0}"
                                                HorizontalAlignment="Left" MinWidth="130"
                                                Visibility="{Binding HasVaults, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                IsEnabled="{Binding DataContext.IsBusy,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Converter={StaticResource InverseBoolConverter}}"
                                                Command="{Binding DataContext.ChooseCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Managers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,4">
                                        <TextBlock Text="{Binding StateLabel}" DockPanel.Dock="Right"
                                                   Style="{StaticResource HintTextStyle}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource SectionHeaderStyle}"
                                                   Margin="0"/>
                                    </DockPanel>

                                    <TextBlock Text="{Binding DetectedAt}" Style="{StaticResource HintTextStyle}"
                                               TextWrapping="Wrap" Margin="0,0,0,6"/>

                                    <!-- The CLI's own words. It distinguishes locked from signed out
                                         from integration-disabled far better than this app can. -->
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource HintTextStyle}"
                                               Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap"
                                               Margin="0,0,0,6"
                                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- 1Password only, and in every state: the desktop app has to
                                         stay running, and the way back from a restart has an order
                                         to it that nothing else on screen would reveal. -->
                                    <TextBlock Text="{Binding DesktopAppRequirement}" Style="{StaticResource HintTextStyle}"
                                               TextWrapping="Wrap" Margin="0,0,0,8"
                                               Visibility="{Binding ShowDesktopAppRequirement, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                    <!-- The button that owns the prompt. Nothing on the startup path
                                         asks this manager anything, so this is where the unlock,
                                         the Hello gesture and the desktop-app approval happen —
                                         once, for the manager the user actually meant. -->
                                    <StackPanel Visibility="{Binding ShowConnect, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="{Binding ConnectPrompt}" Style="{StaticResource HintTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,0,0,8"/>

                                        <!-- 1Password: the account name and the button belong on one
                                             row, because neither is any use without the other. The
                                             SDK opens its connection *to a named account*, so
                                             Connect with an empty box could only fail — and the
                                             box on its own does nothing until Connect is pressed. -->
                                        <StackPanel Visibility="{Binding IsOnePassword, Converter={StaticResource BoolToVisibilityConverter}}">

                                            <!-- Two ways in, and they need different things: the
                                                 desktop app needs an account name and a running,
                                                 unlocked 1Password; a service account needs a token
                                                 and nothing local at all. Offered as a choice rather
                                                 than inferred, because which one is wanted is a
                                                 decision about the machine, not something the app
                                                 can work out by looking. -->
                                            <RadioButton GroupName="OnePasswordAuth" Margin="0,0,0,4"
                                                         Content="1Password desktop app"
                                                         IsChecked="{Binding UseServiceToken, Converter={StaticResource InverseBoolConverter}}"/>
                                            <RadioButton GroupName="OnePasswordAuth" Margin="0,0,0,8"
                                                         Content="Service account token — no desktop app needed"
                                                         IsChecked="{Binding UseServiceToken}"/>

                                            <!-- Desktop app -->
                                            <StackPanel Visibility="{Binding UsesDesktopApp, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <!-- Said when the mode is chosen, not after it fails:
                                                     the failure is silent and the obvious repair
                                                     does not work, so a user who meets it unwarned
                                                     concludes RavensPort is broken. -->
                                                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           Margin="0,0,0,6"
                                                           Text="{Binding DesktopAppKnownIssue}"
                                                           Visibility="{Binding ShowDesktopAppKnownIssue, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                           Margin="0,0,0,6"
                                                           Text="Your 1Password account name — the exact name at the top of the 1Password desktop app sidebar, such as 'Personal' or 'Our Family'."/>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox Width="230" VerticalAlignment="Center"
                                                             Text="{Binding OnePasswordAccountName, UpdateSourceTrigger=PropertyChanged}"/>
                                                    <Button Content="{Binding ConnectLabel}" Margin="8,0,0,0" MinWidth="170"
                                                            IsEnabled="{Binding DataContext.IsBusy,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                                        Converter={StaticResource InverseBoolConverter}}"
                                                            Command="{Binding DataContext.ConnectCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- Service account. PasswordBox rather than TextBox so
                                                 the token is masked; its Password property is not a
                                                 DependencyProperty and cannot be bound, which is why
                                                 the code-behind pushes it into the view model on
                                                 every change — the same pattern the credential and
                                                 certificate fields use. -->
                                            <StackPanel Visibility="{Binding UsesServiceToken, Converter={StaticResource BoolToVisibilityConverter}}">

                                                <!-- What a bearer token is, before the box it goes
                                                     in. Scoping the vault limits what it opens, not
                                                     who can use it, and none of that is obvious
                                                     from a field labelled "token". -->
                                                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                           Foreground="{StaticResource WarningBrush}"
                                                           Margin="0,0,0,6"
                                                           Text="{Binding ServiceTokenWarning}"/>
                                                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                           Margin="0,0,0,6"
                                                           Text="{Binding TokenCaveat}"
                                                           Visibility="{Binding HasTokenCaveat, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                                <!-- Offered only where a saved token exists, so the
                                                     usual case stays a paste and a button. -->
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                                            Visibility="{Binding ShowSavedToken, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Button Content="Use the saved token" MinWidth="170"
                                                            IsEnabled="{Binding DataContext.IsBusy,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                                        Converter={StaticResource InverseBoolConverter}}"
                                                            Command="{Binding DataContext.UseSavedTokenCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                    <Button Content="Forget saved token" Margin="8,0,0,0"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            IsEnabled="{Binding DataContext.IsBusy,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                                        Converter={StaticResource InverseBoolConverter}}"
                                                            Command="{Binding DataContext.ForgetSavedTokenCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>

                                                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                           Margin="0,0,0,6"
                                                           Text="Not saved unless you ask below. Otherwise you will be asked for it again after every restart, so an install that starts at login serves nothing until it is entered."/>

                                                <StackPanel Orientation="Horizontal">
                                                    <PasswordBox Width="230" VerticalAlignment="Center"
                                                                 PasswordChanged="ServiceTokenBox_PasswordChanged"/>
                                                    <Button Content="{Binding ConnectLabel}" Margin="8,0,0,0" MinWidth="170"
                                                            IsEnabled="{Binding DataContext.IsBusy,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                                        Converter={StaticResource InverseBoolConverter}}"
                                                            Command="{Binding DataContext.ConnectCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>

                                                <CheckBox Margin="0,8,0,0"
                                                          Content="Keep this token on this PC, behind Windows Hello"
                                                          IsChecked="{Binding RememberToken}"
                                                          Visibility="{Binding ShowRememberToken, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                           Margin="21,3,0,0"
                                                           Visibility="{Binding ShowRememberToken, Converter={StaticResource BoolToVisibilityConverter}}"
                                                           Text="Stored encrypted in Windows Credential Manager — never in plain text — and only a Windows Hello gesture on this PC can bring it back. You will be asked to confirm. Service accounts rotate, so you can forget a saved token here at any time."/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Proton Pass has no equivalent field: its session is
                                             RavensPort's own, so there is nothing to name. -->
                                        <Button Content="{Binding ConnectLabel}" HorizontalAlignment="Left" MinWidth="170"
                                                Visibility="{Binding IsOnePassword, Converter={StaticResource InverseBoolToVisibilityConverter}}"
                                                IsEnabled="{Binding DataContext.IsBusy,
                                                            RelativeSource={RelativeSource AncestorType=UserControl},
                                                            Converter={StaticResource InverseBoolConverter}}"
                                                Command="{Binding DataContext.ConnectCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowInstall, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- The command and nothing else. RavensPort does not
                                             install other software and does not send anyone to a
                                             page to get it: putting an executable on this PC is
                                             the user's own decision, taken in their own terminal. -->
                                        <TextBlock Text="Install it, then choose Check again."
                                                   Style="{StaticResource HintTextStyle}" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding InstallCommand, Mode=OneWay}" IsReadOnly="True"
                                                 Visibility="{Binding HasInstallCommand, Converter={StaticResource BoolToVisibilityConverter}}"
                                                 FontFamily="Cascadia Code, Consolas" FontSize="11"
                                                 Margin="0,0,0,8"/>
                                    </StackPanel>

                                    <!-- After a connect that did not work. The box is here as well as
                                         beside the Connect button above because a wrong account
                                         name is the usual reason, and the retry has to be next to
                                         the correction — otherwise fixing it means finding "Check
                                         again" at the bottom of the page first. -->
                                    <StackPanel Visibility="{Binding ShowOnePasswordSettings, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Text="Set your 1Password Account Name:" Style="{StaticResource HintTextStyle}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Enter the exact account name shown at the top of your 1Password desktop app sidebar (e.g. 'Our Family' or 'Personal')." Style="{StaticResource HintTextStyle}" Margin="0,0,0,8"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                            <TextBox Width="230" VerticalAlignment="Center"
                                                     Text="{Binding OnePasswordAccountName, UpdateSourceTrigger=PropertyChanged}"/>
                                            <Button Content="{Binding ConnectLabel}" Margin="8,0,0,0" MinWidth="170"
                                                    IsEnabled="{Binding DataContext.IsBusy,
                                                                RelativeSource={RelativeSource AncestorType=UserControl},
                                                                Converter={StaticResource InverseBoolConverter}}"
                                                    Command="{Binding DataContext.ConnectCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel Visibility="{Binding ShowSignIn, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <!-- 1Password's written steps. For Proton Pass the steps
                                             are the controls below, so this carries only the note
                                             they cannot state for themselves — and it comes after
                                             them, since it is background rather than instruction. -->
                                        <TextBlock Text="{Binding SignInSteps}" Style="{StaticResource HintTextStyle}"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Visibility="{Binding SupportsInAppSignIn, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                                        <TextBlock Text="{Binding TokenCaveat}" Style="{StaticResource HintTextStyle}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasTokenCaveat, Converter={StaticResource BoolToVisibilityConverter}}"/>

                                        <!-- Proton Pass: RavensPort holds its own pass-cli session,
                                             encrypted with a key the user keeps. So the sign-in
                                             happens here rather than in a terminal, and a
                                             pass-cli logout typed elsewhere cannot end it. -->
                                        <StackPanel Visibility="{Binding ShowInAppSignIn, Converter={StaticResource BoolToVisibilityConverter}}">

                                            <!-- Returning: a session is on disk and only needs its
                                                 key. Generate is deliberately not offered here —
                                                 a new key makes that session unopenable, and
                                                 offering both asked the user to know which of two
                                                 situations they were in. -->
                                            <StackPanel Visibility="{Binding DataContext.NeedsSessionKey,
                                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                                <!-- Hello first when there is a key behind it. The
                                                     gesture is bound to the decryption, not merely
                                                     checked before it — see HelloKeyProtector. -->
                                                <StackPanel Margin="0,0,0,10"
                                                            Visibility="{Binding DataContext.CanUnlockWithHello,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                               Margin="0,0,0,6"><Run
                                                        Style="{StaticResource EmphasisRunStyle}">Unlock with Windows Hello.</Run><Run
                                                        xml:space="preserve"> Your session key is held in Windows Credential Manager, encrypted so that only a Hello gesture on this PC can decrypt it. RavensPort cannot read it without you, and it is never shown to you either.</Run></TextBlock>
                                                    <Button Content="Unlock with Windows Hello" HorizontalAlignment="Left"
                                                            IsEnabled="{Binding DataContext.IsBusy,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                                        Converter={StaticResource InverseBoolConverter}}"
                                                            Command="{Binding DataContext.UnlockWithHelloCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </StackPanel>
                                                <!-- The way out has to be on this page. Sign out is
                                                     on the Settings tab, which needs an open vault
                                                     to reach — so telling a locked-out user to go
                                                     there sent them to the far side of the door
                                                     they could not open. -->
                                                <StackPanel Visibility="{Binding DataContext.IsConfirmingDiscard,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                                                         Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                               Margin="0,0,0,6"
                                                               Text="Lost the key? Nothing is gone — everything RavensPort stores is in Proton Pass. Throw this session away and sign in again for a new key."/>
                                                    <Button Content="Discard this session" HorizontalAlignment="Left"
                                                            Style="{StaticResource GhostButtonStyle}"
                                                            Command="{Binding DataContext.DiscardSessionCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </StackPanel>

                                                <StackPanel Visibility="{Binding DataContext.IsConfirmingDiscard,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                               Margin="0,0,0,6" Foreground="{StaticResource ErrorBrush}"
                                                               Text="This deletes RavensPort's locked session from this PC. Your vault is untouched. Because the key is gone, RavensPort cannot tell Proton to end the session — it stays in your Proton account's session list until it expires, and you can revoke it there if you want it gone sooner."/>
                                                    <WrapPanel>
                                                        <Button Content="Discard this session" Margin="0,0,8,0"
                                                                Command="{Binding DataContext.DiscardSessionCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                        <Button Content="Cancel" Style="{StaticResource GhostButtonStyle}"
                                                                Command="{Binding DataContext.CancelDiscardCommand,
                                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- First time: nothing to unlock, sign in through browser. -->
                                            <StackPanel Visibility="{Binding DataContext.IsFirstSignIn,
                                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                           Margin="0,0,0,2"><Run
                                                    Style="{StaticResource EmphasisRunStyle}">First sign-in.</Run></TextBlock>
                                                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                           Margin="8,0,0,8"
                                                           Text="Sign in through your browser. RavensPort will show you the link."/>

                                                <!-- Said before the gesture is asked for, not after:
                                                     it is what the Hello prompt about to appear is
                                                     for, and a prompt with no stated reason is one
                                                     people learn to click through. -->
                                                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                           Margin="0,0,0,8"
                                                           Visibility="{Binding DataContext.IsHelloAvailable,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                                        Converter={StaticResource BoolToVisibilityConverter}}"><Run
                                                    Style="{StaticResource EmphasisRunStyle}">Windows Hello will ask before the sign-in starts.</Run><Run
                                                    xml:space="preserve"> RavensPort generates a session key, encrypts it so that only a Hello gesture on this PC can decrypt it, and keeps it in Windows Credential Manager. You never see the key, and after a restart a gesture is all it takes to reopen the session. Cancel that prompt and nothing is created.</Run></TextBlock>

                                                <!-- Says what the session key is NOT, first. Every wrong
                                                     guess about it is alarming: that it is a Proton
                                                     password, that Proton receives it, or that
                                                     RavensPort is keeping the user's secrets on
                                                     this PC and locking them with it. -->
                                                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                           Margin="0,0,0,8"><Run
                                                    Style="{StaticResource EmphasisRunStyle}">RavensPort stores none of your data on this PC.</Run><Run
                                                    xml:space="preserve"> Every credential, route, funnel and key lives in your Proton Pass vault and nowhere else. The one thing kept here is the Proton Pass sign-in session, and the key that encrypts it never leaves Windows Credential Manager unencrypted. It is not your Proton password, and Proton never receives it.</Run></TextBlock>

                                                <!-- No Hello, no in-app sign-in. Stated rather than
                                                     worked around: the key is never displayed, so
                                                     Hello is the only thing that could bring it
                                                     back, and a sign-in without it would produce a
                                                     session that dies unopenable at the next
                                                     restart with nothing said about it. -->
                                                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                           Margin="0,0,0,8" Foreground="{StaticResource ErrorBrush}"
                                                           Visibility="{Binding DataContext.NeedsHelloSetup,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                                        Converter={StaticResource BoolToVisibilityConverter}}"
                                                           Text="{Binding DataContext.HelloRequiredMessage,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl},
                                                                  Mode=OneTime}"/>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal"
                                                        Visibility="{Binding DataContext.CanShowSignInButton,
                                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Button Content="Sign in to Proton Pass"
                                                        IsEnabled="{Binding DataContext.IsSigningIn,
                                                                    RelativeSource={RelativeSource AncestorType=UserControl},
                                                                    Converter={StaticResource InverseBoolConverter}}"
                                                        Command="{Binding DataContext.SignInProtonCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                <Button Content="Cancel" Margin="8,0,0,0"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Visibility="{Binding DataContext.IsSigningIn,
                                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                                     Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Command="{Binding DataContext.CancelSignInCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </StackPanel>

                                            <!-- Shown, never launched: the payload in this URL is a
                                                 live single-use handle, and firing it at whatever
                                                 browser is default may well be a profile signed in
                                                 as someone else. -->
                                            <StackPanel Margin="0,10,0,0"
                                                        Visibility="{Binding DataContext.HasSignInUrl,
                                                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                                                     Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                           Margin="0,0,0,4"
                                                           Text="Open this in your browser to finish signing in. It works once, so do not share it."/>
                                                <TextBox Text="{Binding DataContext.SignInUrl, Mode=OneWay,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                         IsReadOnly="True" TextWrapping="Wrap"
                                                         FontFamily="Cascadia Code, Consolas" FontSize="11"
                                                         Margin="0,0,0,6"/>
                                                <Button Content="Copy link" HorizontalAlignment="Left"
                                                        Style="{StaticResource GhostButtonStyle}"
                                                        Command="{Binding DataContext.CopyToClipboardCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding DataContext.SignInUrl,
                                                                           RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                            </StackPanel>

                                            <!-- Last, and quietly: this answers "but I already
                                                 signed in with pass-cli", which is a question the
                                                 user only has after reading everything above. -->
                                            <TextBlock Text="{Binding SignInSteps}" Margin="0,12,0,0"
                                                       Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Sign-out lives on the Settings tab, not here. This page is
                                         only shown when there is no usable vault, so a button that
                                         needed a working session would never be reachable on it. -->

                                    <!-- More than one vault here holds a configuration: separate
                                         profiles, and opening one would overwrite the other on the
                                         next save. Only the user knows which they meant. -->
                                    <StackPanel Visibility="{Binding ShowVaultChoice, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                   Margin="0,0,0,8"
                                                   Text="More than one vault here holds a RavensPort configuration. Each is a separate set of credentials, routes and funnels — choose the one to open."/>
                                        <ItemsControl ItemsSource="{Binding VaultChoices}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <!-- Up to the view rather than counting
                                                         ItemsControl levels: this button lives in
                                                         an ItemsControl inside another one. -->
                                                    <Button Content="{Binding Name}" Margin="0,0,8,6" MinWidth="120"
                                                            IsEnabled="{Binding DataContext.IsBusy,
                                                                        RelativeSource={RelativeSource AncestorType=UserControl},
                                                                        Converter={StaticResource InverseBoolConverter}}"
                                                            Command="{Binding DataContext.UseNamedVaultCommand,
                                                                      RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <!-- Both offered in every state a vault could be used in, Ready
                                         included: switching vaults is how one install keeps
                                         several separate sets of credentials and routes. -->
                                    <StackPanel Visibility="{Binding ShowVaultActions, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                   Margin="0,12,0,6"
                                                   Visibility="{Binding HasVaults, Converter={StaticResource BoolToVisibilityConverter}}"><Run
                                            xml:space="preserve">Open a RavensPort vault you already have. Listed here are only vaults named after RavensPort that are empty or already RavensPort's, because </Run><Run
                                            Style="{StaticResource EmphasisRunStyle}">RavensPort works in a vault of its own and never reads or writes your other vaults</Run><Run
                                            xml:space="preserve">. Inside the one it uses, </Run><Run
                                            Style="{StaticResource EmphasisRunStyle}">it only ever removes items it created itself</Run><Run
                                            xml:space="preserve"> — the ones titled 'RavensPort …' — and only once you have deleted the credential, route or funnel they belong to. Anything else in that vault is left untouched.</Run></TextBlock>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                                    Visibility="{Binding HasVaults, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <!-- Not IsEditable: the dark theme's ComboBox template
                                                 has no PART_EditableTextBox, so an editable one
                                                 shows nothing whatever is selected. Typing a name
                                                 belongs to "create" below in any case. -->
                                            <ComboBox Width="190" VerticalAlignment="Center"
                                                      ItemsSource="{Binding Vaults}"
                                                      SelectedItem="{Binding SelectedVaultName, Mode=TwoWay}"/>
                                            <Button Content="Use this vault" Margin="8,0,0,0"
                                                    Style="{StaticResource GhostButtonStyle}"
                                                    IsEnabled="{Binding DataContext.IsBusy,
                                                                RelativeSource={RelativeSource AncestorType=UserControl},
                                                                Converter={StaticResource InverseBoolConverter}}"
                                                    Command="{Binding DataContext.UseExistingVaultCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>

                                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"
                                                   Margin="0,0,0,6"
                                                   Text="Or create one. The profile is optional and only names the vault: leave it blank for 'RavensPort', or type Work or Personal to keep a second set of credentials, routes and funnels apart from the first."/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox Width="190" VerticalAlignment="Center"
                                                     Text="{Binding Profile, UpdateSourceTrigger=PropertyChanged}"/>
                                            <!-- The name the profile assembles into. Shown because
                                                 it is what the user will see in their password
                                                 manager, and a name built out of sight is one they
                                                 cannot check before it exists. -->
                                            <TextBlock Text="{Binding NewVaultName}" Margin="8,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource HintTextStyle}"/>
                                            <Button Content="Create this vault" Margin="8,0,0,0"
                                                    IsEnabled="{Binding DataContext.IsBusy,
                                                                RelativeSource={RelativeSource AncestorType=UserControl},
                                                                Converter={StaticResource InverseBoolConverter}}"
                                                    Command="{Binding DataContext.CreateVaultCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- The way in for someone who wants to see what this is before handing it a vault,
                     and the way to test a build without unlocking anything. Everything works; the
                     configuration simply has nowhere to live but this process. -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Try it without a password manager" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"><Run
                            xml:space="preserve">Single use runs RavensPort on memory alone — every tab, every route, every MCP funnel, every credential, with </Run><Run
                            Style="{StaticResource EmphasisRunStyle}">no password manager involved and no prompt to unlock anything</Run><Run
                            xml:space="preserve">.</Run></TextBlock>
                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"><Run
                            Style="{StaticResource EmphasisRunStyle}">Nothing is saved.</Run><Run
                            xml:space="preserve"> The configuration exists only inside this process: disconnecting on the Settings tab discards it, and so does closing RavensPort. Real credentials and real tokens work here — they are simply gone afterwards, and any OAuth grant you connect will need connecting again next time.</Run></TextBlock>
                        <Button Content="Start in single use" HorizontalAlignment="Left" MinWidth="170"
                                Style="{StaticResource GhostButtonStyle}"
                                IsEnabled="{Binding CanCheck}"
                                Command="{Binding StartSingleUseCommand}"/>
                    </StackPanel>
                </Border>

                <!-- Only shown when the pre-vault file is actually there. -->
                <Border Style="{StaticResource SectionCardStyle}" Margin="0,0,0,14"
                        Visibility="{Binding HasLegacyStore, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Your old configuration" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="This version does not read the old store.dat file in %AppData%\RavensPort — credentials, routes, funnels and proxy keys all need to be set up again, and every client needs its new key. The old file is left alone in case you still want anything out of it."/>
                        <Button Content="Delete the old file" HorizontalAlignment="Left"
                                Style="{StaticResource GhostButtonStyle}"
                                Command="{Binding DeleteLegacyStoreCommand}"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Keeping the vault available" Style="{StaticResource SectionHeaderStyle}"/>
                        <TextBlock Style="{StaticResource HintTextStyle}" TextWrapping="Wrap"><Run
                            xml:space="preserve">While your password manager is locked, </Run><Run
                            Style="{StaticResource EmphasisRunStyle}">RavensPort cannot save changes and does not refresh OAuth tokens</Run><Run
                            xml:space="preserve"> — so routes using them stop working once their current token expires. API-key routes keep working. If that happens often, the Settings tab explains how to keep the vault reachable, including token options that do not require leaving anything unlocked.</Run></TextBlock>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Style="{StaticResource FooterBarStyle}">
            <DockPanel>
                <Button Content="Check again" DockPanel.Dock="Right" MinWidth="100"
                        IsEnabled="{Binding CanCheck}"
                        Command="{Binding CheckCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource FooterTextStyle}"
                           VerticalAlignment="Center"/>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
