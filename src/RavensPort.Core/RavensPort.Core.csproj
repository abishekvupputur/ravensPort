<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Both frameworks — see the note in Directory.Build.props on which projects take which. -->
    <TargetFrameworks>$(PortableTargetFramework);$(WindowsTargetFramework)</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    The SDK defines WINDOWS for a net8.0-windows target already; this states it so the one #if in
    this project does not depend on knowing that, and so it reads the same as any other conditional
    constant.
  -->
  <PropertyGroup Condition="$(TargetFramework.StartsWith('net8.0-windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <!--
    The three files that cannot compile without Windows: WinRT KeyCredentialManager, the Credential
    Manager P/Invokes it stores into, and the protector that binds them together. Everything else in
    this project — the OAuth flows, the proxy config, the MCP funnel, the vault mapping, the CLI
    runner — builds for both.

    Deliberately a short list. ExecutableSignature and OnePasswordNativeClient look Windows-bound
    and are not: a DllImport is resolved at run time, not compile time, so both build portable and
    fail — or, in the 1Password case, succeed against a .so — where it actually matters. Excluding
    a file that compiles fine only moves the problem into its callers.
  -->
  <ItemGroup Condition="!$(TargetFramework.StartsWith('net8.0-windows'))">
    <Compile Remove="Vault\IHelloSigner.cs" />
    <Compile Remove="Vault\HelloKeyProtector.cs" />
    <Compile Remove="Vault\WindowsCredentialStore.cs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Inlined as a data URI on the OAuth callback page, which is served by HttpListener with no
      static-file root to serve anything from. Scaled down from the App's full-size logo: the
      whole page is base64'd into one response, so pixels above what it displays are pure weight.
    -->
    <EmbeddedResource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <!--
      System.Security.Cryptography.ProtectedData is gone with SecureStore: DPAPI was the whole of
      the old local store, and secrets now live in the user's password manager instead.
    -->
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.0.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="IdentityModel.OidcClient" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The refresh loop's tick is timer-driven on a 60-second interval, so the one thing worth
      asserting about it — that it attempts nothing while the vault is locked — is unreachable
      from outside without waiting a minute per test.
    -->
    <InternalsVisibleTo Include="RavensPort.Core.Tests" />
  </ItemGroup>

</Project>
