<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFramework comes from Directory.Build.props — see the note there on why it is shared. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--
      Required by the LibraryImport source generator, not by any code written here: the P/Invoke
      stubs it emits for WindowsCredentialStore, ExecutableSignature and the 1Password DLL are
      generated with `unsafe` bodies. Nothing in this project's own source uses a pointer, and the
      generator replaces hand-written marshalling that was less safe than what it produces.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Inlined as a data URI on the OAuth callback page, which is served by HttpListener with no
      static-file root to serve anything from. Scaled down from the App's full-size logo: the
      whole page is base64'd into one response, so pixels above what it displays are pure weight.
    -->
    <EmbeddedResource Include="Assets\logo.png" />

    <!--
      The worked example the API to MCP tab loads into its editor and saves to disk. Embedded
      rather than written as a string literal so a test can parse the very bytes the user gets,
      which is what stops the documented shape from drifting away from the validator.
    -->
    <EmbeddedResource Include="Assets\sample-api-mcp-manifest.json" />
  </ItemGroup>

  <ItemGroup>
    <!--
      System.Security.Cryptography.ProtectedData is gone with SecureStore: DPAPI was the whole of
      the old local store, and secrets now live in the user's password manager instead.
    -->
    <PackageReference Include="Google.Apis.Auth" Version="1.75.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
    <PackageReference Include="IdentityModel.OidcClient" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The refresh loop's tick is timer-driven on a 60-second interval, so the one thing worth
      asserting about it — that it attempts nothing while the vault is locked — is unreachable
      from outside without waiting a minute per test.
    -->
    <InternalsVisibleTo Include="RavensPort.Core.Tests" />
  </ItemGroup>

</Project>
