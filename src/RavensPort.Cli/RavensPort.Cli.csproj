<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ravensport-cli: RavensPort with no window. `serve` runs the proxy headless on a machine with no
    display, and every other command manages whichever RavensPort is running — this one or the
    desktop app — through its admin socket. A console project of its own because RavensPort.exe is
    a WinExe, which Windows starts without a console, and because a server should not need the
    display libraries Avalonia pulls in. References Core only.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>$(PortableTargetFramework);$(WindowsTargetFramework)</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ravensport-cli</AssemblyName>
    <RootNamespace>RavensPort.Cli</RootNamespace>
    <ApplicationIcon>..\RavensPort.App\Assets\tray.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.StartsWith('net10.0-windows'))">
    <DefineConstants>$(DefineConstants);WINDOWS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RavensPort.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RavensPort.Core\RavensPort.Core.csproj" />
  </ItemGroup>

  <!-- The 1Password native, exactly as RavensPort.App.csproj ships it; see the notes there. -->
  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <Content Include="..\OnePasswordNative\onepassword.dll" Condition="Exists('..\OnePasswordNative\onepassword.dll')">
      <Link>onepassword.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="'$(OS)' != 'Windows_NT'">
    <Content Include="../OnePasswordNative/libonepassword.so" Condition="Exists('../OnePasswordNative/libonepassword.so')">
      <Link>libonepassword.so</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.12" />
  </ItemGroup>

</Project>
